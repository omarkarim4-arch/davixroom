# --- Secret. Never commit, never log. -----------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# Must connect as a role WITHOUT the BYPASSRLS attribute: `postgres` and
# `service_role` both bypass row level security, which would silently disable
# every tenancy policy in the schema.
DATABASE_URL=

